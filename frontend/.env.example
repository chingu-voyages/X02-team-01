# Public configuration for the Next.js app.
# These values are embedded in the browser bundle at BUILD time.
# Never put secrets here — NEXT_PUBLIC_* is visible to anyone.
# Copy to `.env.local` and adjust if needed:  cp .env.example .env.local

# Optional absolute API base (baked into the browser bundle at build
# time). Leave unset for same-origin routing: apiRequest defaults to
# `/api/v1`, which the server proxies to the backend at request time.
# A localhost value here breaks hosted frontends.
# NEXT_PUBLIC_API_URL=
