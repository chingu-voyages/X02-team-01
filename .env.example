
POSTGRES_DB=jhep_db
POSTGRES_USER=jhep
POSTGRES_PASSWORD=replace_with_local_password

# JWT Authentication
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# DNS HOSTING URL
MEDIA_BASE_URL=

# Registration verification email (JHEP-24)
# console = the link logged (tests/CI default) | mailpit = the local catcher
# smtp = a REAL external transport (Gmail app-password, Mailgun, SES, ...)
# resend = Resend's API (the JHEP-102-confirmed production candidate)
EMAIL_DELIVERY=
EMAIL_FROM=no-reply@jobhackers.local
EMAIL_SMTP_HOST=127.0.0.1
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_STARTTLS=true
EMAIL_API_KEY=
VERIFICATION_LINK_BASE=http://127.0.0.1:8010/api/v1/auth/verify
VERIFY_TOKEN_TTL_HOURS=24
RESEND_INTERVAL_SECONDS=60
