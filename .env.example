
POSTGRES_DB=jhep_db
POSTGRES_USER=jhep
POSTGRES_PASSWORD=replace_with_local_password

# JWT Authentication
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Public HTTPS base URL for hosted practice-question images.
# Development example: https://pub-xxxxxxxx.r2.dev
# Production should use a Cloudflare custom domain.
# Do not include a trailing slash or an individual object key.
MEDIA_BASE_URL=

# Cloudflare R2 write access — backend only.
# Create an Object Read & Write token scoped to the question-image bucket.
# Never expose these values through NEXT_PUBLIC_* variables.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=jhep-question-images-dev

# Question image upload limits.
MAX_QUESTION_IMAGE_BYTES=5242880
MAX_QUESTION_IMAGE_PIXELS=20000000

# Registration verification email (JHEP-24)
# console = the link logged (tests/CI default) | mailpit = the local catcher
# smtp = a REAL external transport (Gmail app-password, Mailgun, SES, ...)
# resend = Resend's API (the JHEP-102-confirmed production candidate)
EMAIL_DELIVERY=
EMAIL_FROM=no-reply@jobhackers.local
EMAIL_SMTP_HOST=127.0.0.1
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_STARTTLS=true
EMAIL_API_KEY=
VERIFICATION_LINK_BASE=http://127.0.0.1:8010/api/v1/auth/verify
VERIFY_TOKEN_TTL_HOURS=24
RESEND_INTERVAL_SECONDS=60


# Next.js server-side API proxy target.
#
# The browser ALWAYS calls the same-origin /api/v1/* route.
# This value is read by the Next.js server at request time.
#
# Local FastAPI:
BACKEND_PROXY_TARGET=http://127.0.0.1:8010

# Do NOT add NEXT_PUBLIC_API_URL.
# API routing is intentionally handled through the runtime proxy so the
# frontend does not bake backend addresses into the browser bundle.

# Multi-factor authentication (JHEP-109 / JHEP-207).
# Startup permits a missing key, but Administrator enrollment is mandatory
# before administrative access. Configure a stable backend-only secret.
# Generate only for a fresh environment; never overwrite an existing key.
# See docs/administrator-security.md for onboarding and recovery limitations.
MFA_ENCRYPTION_KEY=
MFA_CHALLENGE_MINUTES=5
MFA_MAX_ATTEMPTS=5
MFA_RECOVERY_CODE_COUNT=8
