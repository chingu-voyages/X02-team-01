# ---------------------------------------------------------------------------
# Local development configuration.
# Copy this file, then fill in real values:
#     cp .env.example .env
# `.env` is gitignored — never commit real credentials.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# Free-form environment name: local | ci | staging | production
ENVIRONMENT=local
# Comma-separated browser origins allowed to call the API
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL ------------------------------------------------------------
# Use 127.0.0.1 when running the backend on your machine.
# Use the compose service name (`postgres`) when the backend runs in compose.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=jhep_db
POSTGRES_USER=jhep
POSTGRES_PASSWORD=replace_with_local_password

# --- Frontend (public, build-time) -----------------------------------------
# Base URL of the API as seen from the browser.
# Anything prefixed NEXT_PUBLIC_ is visible to users — never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Authentication (not used yet; uncomment when the auth ticket lands) ---
# JWT_SECRET_KEY=replace_with_a_long_random_string
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
